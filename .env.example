# ============================================
# TripWise AI — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control

# --- Database ---
DATABASE_URL=sqlite:///./tripwise.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tripwise

# --- Authentication ---
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI Provider ---
# Supported: gemini, openai, demo
AI_PROVIDER=demo
AI_API_KEY=your-ai-api-key
AI_MODEL=gemini-2.0-flash
# For OpenAI: AI_MODEL=gpt-4o-mini

# --- Maps ---
# Leave empty to use OpenStreetMap (free, no key needed)
MAPS_PROVIDER=openstreetmap
MAPS_API_KEY=

# --- Weather (optional) ---
WEATHER_API_KEY=
WEATHER_PROVIDER=openweathermap

# --- Application ---
APP_NAME=TripWise AI
APP_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=10
